{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // TypeScript 7 `baseUrl`'ü kaldırdı; yollar tsconfig'e göre göreli yazılır.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `e2e` ve `playwright.config.ts` de derlemeye dahil: dışarıda kaldıkları sürece
  // bir e2e testi ölü bir çeviri anahtarına (`tr['...']`) ya da kalkmış bir dışa
  // aktarıma başvurduğunda `npm run typecheck` sessiz kalıyordu — dalga 8'de
  // güncellenmeyen LoRaWAN FOpts testi tam bu yüzden kırmızı kaldı.
  "include": ["src", "e2e", "vite.config.ts", "vitest.setup.ts", "playwright.config.ts"]
}
